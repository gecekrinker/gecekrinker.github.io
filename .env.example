# Bu dosyayı `.env.local` adıyla kopyala ve doldur. .env.local git'e girmez.

# --- Spotify (şu an çalan şarkı) ---
# developer.spotify.com/dashboard > uygulaman > Settings (Basic Information)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# `npm run spotify:auth` bunu kendisi doldurur, elle yazmana gerek yok
SPOTIFY_REFRESH_TOKEN=

# --- Last.fm (Spotify çalmıyorsa son dinlenenlerden rastgele biri) ---
# last.fm/api/account/create ile alınan API key (Shared secret gerekmiyor)
LASTFM_API_KEY=
# Last.fm kullanıcı adın (profil linkindeki: last.fm/user/<BU>)
LASTFM_USERNAME=

# --- İsteğe bağlı ---
# LASTFM_LIMIT=10          # kaç son şarkı arasından seçilsin (varsayılan 10)
